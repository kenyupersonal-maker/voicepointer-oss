// 等离子球（2026-11-10 新做；Ken：水面不行就去掉，做点炫酷的主题）。
// 主题：一颗等离子球，玻璃球里的电弧追着声音走。由此反推：
// - 材质：一颗深色的玻璃球，中间一个发亮的电极，电弧从电极伸到球壁，白芯、紫红到蓝的光晕；
//   球壁只有一圈细亮边和左上一点反光；
// - 说话时动的是电弧自己：安静时只有一两根细电弧慢慢游走，声音越大电弧越多、越亮、抖得越快；
// - 往上推：像手指点在球顶，所有电弧被吸到顶上那一点，球顶亮起来；松手一道电打上去；
// - 往下推：电弧缩回电极，球暗下去；松手熄灭。

// Brightness of filament i at polar (r, phi): (white core, coloured glow).
vec2 pl_arc(float r, float phi, float i, float ms, float reach, float busy, UARG u) {
    float t = u.time;
    float wander = i * 1.2566 + 0.7 * sin(t * (0.45 + 0.11 * i) + i * 2.1) + 0.6 * gnoise(vec2(t * 0.6, i * 9.0));
    float home = 1.5708 + (i - 2.0) * 0.07;
    float turns = floor((wander - home) / TAU + 0.5);
    float ang0 = mix(wander - turns * TAU, home, ms);
    float pull = 1.0 - 0.75 * ms * smoothstep(8.0, 28.0, r);            // the arcs straighten toward the touch
    float bend = (0.40 * gnoise(vec2(r * 0.12 + i * 7.0, t * (2.2 + 2.5 * busy) + i))
               + 0.16 * gnoise(vec2(r * 0.42 - t * 7.0, i * 3.0))) * smoothstep(1.0, 11.0, r) * pull;
    float da = phi - (ang0 + bend);
    da -= TAU * floor(da / TAU + 0.5);
    float d = abs(da) * r;
    float inside = smoothstep(reach, reach - 5.0, r);
    float flick = 0.72 + 0.28 * sin(t * 31.0 + i * 5.3) * sin(t * 17.0 + i * 1.7);
    float core = exp(-d * d / 0.55) * inside * flick;
    float glow = exp(-d / 2.4) * inside * flick;
    return vec2(core, glow);
}

vec4 skin_plasma(vec2 p, UARG u) {
    float dark = u.dark;
    float S = u.send, C = u.cancel;
    float ms = hud_smoother(0.0, 1.0, snapSend(u));
    float mc = hud_smoother(0.0, 1.0, snapCancel(u));
    if (S > 0.0) { ms = 1.0; mc = 0.0; }
    if (C > 0.0) { mc = 1.0; ms = 0.0; }
    float L = u.level, pk = u.peak, t = u.time;
    float g = max(0.2 + 0.8 * u.appear, 0.001);
    float off = easeInOut(saturate(C / 0.8));
    vec2 q = p / g;
    float r = length(q);
    float phi = atan2(q.y, q.x);
    float R = 30.0;
    float d = (r - R) * g;
    float busy = saturate(L + 0.6 * pk);
    float power = (1.0 - 0.85 * mc) * (1.0 - off);
    float ballA = (1.0 - smoothstep(0.55, 1.0, S)) * (1.0 - smoothstep(0.75, 1.0, C)) * u.appear;

    // the bolt that leaves the top on send
    vec4 bolt = vec4(0.0);
    if (S > 0.0) {
        float top = R + 150.0 * easeOutCubic(saturate(S / 0.55));
        float yy = q.y;
        float bx = 4.5 * gnoise(vec2(yy * 0.11, t * 24.0)) + 2.0 * gnoise(vec2(yy * 0.37, t * 31.0));
        float db = abs(q.x - bx * smoothstep(R, R + 14.0, yy));
        float seg = step(R - 2.0, yy) * step(yy, top) * (1.0 - smoothstep(0.45, 0.95, S));
        float bc = exp(-db * db / 0.7) * seg;
        float bg = exp(-db / 3.0) * seg * 0.55;
        vec3 boltC = vec3(1.0) * bc + vec3(0.72, 0.50, 1.0) * bg;
        bolt = vec4(saturate(boltC), saturate(bc + bg * (dark > 0.5 ? 0.3 : 0.85)));
    }
    // light the ball throws round itself
    float aura = exp(-max(d, 0.0) / 9.0) * (0.10 + 0.22 * busy + 0.25 * ms) * power * ballA;
    vec3 auraC = mix(vec3(0.62, 0.42, 1.0), vec3(0.55, 1.0, 0.70), 0.6 * ms);
    vec4 back = vec4(auraC * aura * (dark > 0.5 ? 1.0 : 0.55), aura * (dark > 0.5 ? 0.15 : 0.55)) * saturate(d / 1.5 + 0.5);
    if (d > 1.5) return over(bolt, back) * (1.0 - u.fade);

    // the dark glass and the glow inside it
    vec3 col = vec3(0.045, 0.030, 0.085);
    col += vec3(0.42, 0.24, 0.85) * exp(-r * r / 150.0) * (0.35 + 0.45 * busy) * power;
    col += vec3(0.20, 0.16, 0.50) * (0.10 + 0.10 * busy) * power;
    // the arcs: one or two when quiet, all six when loud; all of them when the touch at the top calls them
    float reach = mix(R - 0.5, 5.0, max(mc, off));
    vec3 arcs = vec3(0.0);
    for (int i = 0; i < 6; i++) {
        float fi = float(i);
        float on = max(smoothstep(fi * 0.15 - 0.12, fi * 0.15 + 0.06, 0.18 + busy), ms);
        if (on <= 0.001) continue;
        vec2 a = pl_arc(r, phi, fi, ms, reach, busy, u);
        vec3 glowC = mix(vec3(0.95, 0.45, 1.0), vec3(0.45, 0.60, 1.0), saturate(r / R));
        arcs += (vec3(1.0) * a.x * 1.2 + glowC * a.y * 0.55) * on;
    }
    col += arcs * power * (0.75 + 0.5 * busy);
    // where the arcs land on the glass at the top when aimed, and the electrode in the middle
    vec2 touch = q - vec2(0.0, R - 2.0);
    col += mix(vec3(0.9, 0.7, 1.0), vec3(0.6, 1.0, 0.75), 0.7) * exp(-dot(touch, touch) / 26.0) * ms * 1.3 * power;
    col += vec3(1.0, 0.88, 1.0) * exp(-r * r / 9.0) * (0.9 + 0.5 * busy) * (0.25 + 0.75 * power);
    // the glass: a thin bright rim and a small reflection
    float rim = pow(saturate(r / R), 7.0);
    col += vec3(0.42, 0.42, 0.62) * rim * 0.55;
    vec2 hl = (q / R - vec2(-0.40, 0.52)) / vec2(0.22, 0.12);
    col += vec3(1.0) * exp(-dot(hl, hl)) * 0.30;
    float a = cover(d, u) * ballA * (dark > 0.5 ? 0.88 : 0.94);
    return over(bolt, over(vec4(saturate(col) * a, a), back)) * (1.0 - u.fade);
}
