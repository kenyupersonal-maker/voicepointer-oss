// 玻璃珠：一颗有体积的玻璃球（形状同液态金属：圆 → 朝上的圆角三角 / 扁药丸）。
// 系统液态玻璃在永不获得焦点的浮层里只会变成一团雾白，没法真实折射，所以这里按真实光学画：
// - 折射：透过球看到的是被翻转、边缘被拉远的背后（中间亮、边缘暗），RGB 各用略不同的折射率 → 边缘色散；
// - 反射：菲涅尔，边缘反射强，反射里有顶灯（柔光箱）、右侧条灯；
// - 高光：顶灯的锐利高光；光穿过球在另一侧聚焦成内部的亮月牙；
// - 页面：顶灯下球投出很淡的影子，影子中心有一个焦散亮斑；
// - 被指向的 Send / Cancel 是一盏彩色灯：球朝向它的一面有彩色高光和反射，
//   光穿过球在另一侧页面上聚成彩色焦散（common.hsl 的 page_light，glass = 1）。

vec3 gb_front(vec3 d, float dark, vec3 lc, vec3 ld, float I) {
    vec3 top = dark > 0.5 ? vec3(0.30, 0.33, 0.40) : vec3(0.93, 0.95, 1.00);
    vec3 bot = dark > 0.5 ? vec3(0.03, 0.035, 0.05) : vec3(0.40, 0.42, 0.47);
    vec3 c = mix(bot, top, smoothstep(-0.35, 0.45, d.y));
    c += vec3(1.30) * smoothstep(0.935, 0.975, dot(d, normalize(vec3(-0.50, 0.62, 0.60))));
    c += vec3(0.55) * smoothstep(0.986, 0.996, dot(d, normalize(vec3(0.86, 0.02, 0.51))));
    float l = max(dot(d, ld), 0.0);
    c += lc * I * (3.0 * pow(l, 60.0) + 0.45 * pow(l, 6.0));
    return c;
}

vec3 gb_back(vec2 t, float dark) {
    float bend = length(t);
    vec3 page = dark > 0.5 ? vec3(0.13, 0.135, 0.15) : vec3(0.975, 0.98, 0.985);
    vec3 room = dark > 0.5 ? vec3(0.015, 0.02, 0.03) : vec3(0.26, 0.28, 0.33);
    vec3 c = mix(page, room, smoothstep(0.30, 0.95, bend));
    // the bright top of the scene appears upside down in the lower part of the ball
    c += (dark > 0.5 ? vec3(0.30, 0.33, 0.38) : vec3(0.05, 0.05, 0.06)) * smoothstep(0.05, 0.75, t.y) * (1.0 - smoothstep(0.75, 1.05, bend));
    return c;
}

vec4 skin_waterdrop(vec2 p, UARG u) {
    vec4 st = drop_state(u);
    float cy = drop_centerY(st);
    float d = drop_sdf(p, st, u);
    float S = u.send, C = u.cancel;
    float dark = u.dark;
    float light = dark > 0.5 ? 0.0 : 1.0;
    float g = (0.2 + 0.8 * u.appear) * (1.0 - st.w) * (1.0 - smoothstep(0.3, 0.9, S));
    // page: key-light shadow with a caustic in it, plus the lamp's light and caustic
    vec2 c0 = vec2(0.0, cy);
    vec2 sq = (p - c0 - vec2(6.0, -8.0)) / (vec2(23.0, 20.0) * max(g, 0.05));
    float shadow = exp(-dot(sq, sq) * 1.3) * g;
    vec2 cq = (p - c0 - vec2(5.0, -9.0)) / (vec2(8.5, 6.0) * max(g, 0.05));
    float kc = exp(-dot(cq, cq)) * g;
    float outside = saturate(d / 1.5 + 0.5);
    vec4 back = light > 0.5
        ? vec4(vec3(0.0), saturate(shadow * 0.13 - kc * 0.10)) + vec4(vec3(1.0, 0.98, 0.92) * kc * 0.10, kc * 0.06)
        : vec4(vec3(0.0), shadow * 0.30) + vec4(vec3(1.0, 0.97, 0.90) * kc * 0.22, 0.0);
    back *= outside;
    back = over(page_light(p, st, 1.0, u), back);
    if (d > 3.0) return back * (1.0 - u.fade);

    float z = drop_z(p, st, u);
    vec3 n = drop_normal(p, st, u);
    vec3 V = vec3(0.0, 0.0, 1.0);
    float ndv = max(n.z, 0.0);
    float F = 0.04 + 0.96 * pow(1.0 - ndv, 5.0);
    vec2 al = aim_light(u);
    vec3 lc = aim_color(al.x);
    float I = al.y;
    vec3 ld = normalize(aim_lamp(al.x) - vec3(p, z));
    vec3 refl = gb_front(reflect(-V, n), dark, lc, ld, I);
    vec3 Tr = refract(-V, n, 1.0 / 1.43);
    vec3 Tg = refract(-V, n, 1.0 / 1.46);
    vec3 Tb = refract(-V, n, 1.0 / 1.50);
    vec3 refr = vec3(gb_back(Tr.xy * 3.0, dark).r, gb_back(Tg.xy * 3.0, dark).g, gb_back(Tb.xy * 3.0, dark).b);
    vec3 col = mix(refr, refl, F);
    // key-light glint and the focused light inside the far side of the ball
    vec3 key = normalize(vec3(-0.45, 0.62, 0.64));
    float nk = max(dot(n, normalize(key + V)), 0.0);
    col += vec3(1.0) * (1.6 * pow(nk, 220.0) + 0.25 * pow(nk, 24.0));
    float far = saturate(-dot(n.xy, key.xy) / max(length(n.xy), 1e-3)) * pow(1.0 - ndv, 1.5);
    float e = -d;
    col += (dark > 0.5 ? vec3(0.55, 0.60, 0.68) : vec3(0.35, 0.37, 0.40)) * far * smoothstep(1.0, 4.0, e) * (1.0 - smoothstep(5.0, 10.0, e));
    // lamp: coloured highlight and edge light on the side that faces it, and its light gathered on the far inside
    vec3 lt = lamp_terms(p, z, n, u);
    float w = saturate(lt.x * 0.8 + lt.y * 0.9 + lt.z * 0.8);
    col = mix(col, lc * (0.6 + 0.4 * saturate(lt.x)) + vec3(0.8) * saturate(lt.x - 0.7), w * 0.8);
    float lampFar = saturate(dot(n.xy / max(length(n.xy), 1e-3), vec2(0.0, -al.x))) * pow(1.0 - ndv, 1.2) * I;
    col += lc * lampFar * 0.45 * smoothstep(1.0, 4.0, e) * (1.0 - smoothstep(6.0, 12.0, e));
    // dark total-internal-reflection band at the very edge
    col = mix(col, dark > 0.5 ? vec3(0.0) : vec3(0.10, 0.12, 0.16), 0.55 * exp(-pow((e - 0.9) / 0.8, 2.0)));
    col = saturate(col);
    // mostly see-through in the middle, solid glass towards the rim
    float a = cover(d, u) * mix(0.62, 0.97, pow(1.0 - ndv, 0.7));
    a *= 1.0 - smoothstep(0.55, 0.95, S);
    a *= 1.0 - smoothstep(0.85, 1.0, C);
    return over(vec4(col * a, a), back) * (1.0 - u.fade);
}
